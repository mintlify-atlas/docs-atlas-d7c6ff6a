{
  "projectType": "sdk-library",
  "projectName": "Capacitor Crypto API",
  "projectDescription": "A Capacitor plugin that provides a unified cryptographic API for secure key management and operations using platform-specific secure hardware: Secure Enclave on iOS, StrongBox/TEE on Android, and WebCrypto in the browser.",
  "theme": "luma",
  "primaryColor": "#0066cc",
  "lightColor": "#097efc",
  "darkColor": "#70b4fc",
